# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
# Anthropic (Claude Haiku 4.5)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (gpt-5.4-mini). A service-account key (sk-svcacct-...) works too.
OPENAI_API_KEY=sk-...

# Google Gemini (Gemini 3 Flash). From Google AI Studio.
GEMINI_API_KEY=AIza...

# GitHub token used to fetch PR branch commits via the GraphQL API.
# Optional: the tool falls back to the `gh` CLI's auth if this is unset.
# A classic/fine-grained PAT with `repo:read` (public_repo for public repos) is enough.
GITHUB_TOKEN=
